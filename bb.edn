{:paths ["."]
 :deps {camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
        com.github.liquidz/antq {:mvn/version "2.11.1276"}
        hiccup/hiccup {:mvn/version "2.0.0"}}
 :tasks {test:bb {:doc "Run the tests with Kaocha in babashka. Args go to Kaocha, e.g. `bb test:bb --focus smoke-test/test-slugify`"
                  :extra-paths ["test"]
                  :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                  :requires ([kaocha.runner])
                  :task (apply kaocha.runner/-main *command-line-args*)}}}
